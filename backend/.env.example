# Copy this file to backend/.env and edit the values.
SECRET_KEY=change-me-to-a-long-random-string

# MySQL connection (create the database first - see README)
DB_HOST=localhost
DB_PORT=3306
DB_USER=campus_user
DB_PASSWORD=campus_password
DB_NAME=campus_pulse

# Optional: a full URL overrides everything above (mysql:// is fine, sqlite:///campus.db also works)
# DATABASE_URL=sqlite:///campus.db

# Set to 1 to load the fictional demo data automatically the first time the app starts with an empty database
# AUTO_SEED=1

JWT_EXPIRES_HOURS=12
# Only needed if the frontend is hosted on a different domain (e.g. Vercel)
CORS_ORIGINS=http://localhost:5173
